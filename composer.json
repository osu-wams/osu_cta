{
  "name": "osu-wams/osu_cta",
  "description": "Provides a custom block for displaying calls to action on OSU websites.",
  "minimum-stability": "stable",
  "type": "drupal-custom-module",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Matthew Brabham",
      "email": "matthew.brabham@oregonstate.edu"
    }
  ],
  "scripts": {
    "cs-checkstyle": "phpcs -q --report=checkstyle",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "twigcs": "twigcs --twig-version=2"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "squizlabs/php_codesniffer": "^3.7",
    "drupal/coder": "^8.3",
    "friendsoftwig/twigcs": "^6.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "j13k/yaml-lint": "^1.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
